# Pinned upstream sources. Everything in this repository is built on these
# unmodified releases; the fork branches are not needed.

# Linux stable release used by the deployed kernel.
LINUX_URL=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux.git
LINUX_TAG=v7.2.5
LINUX_COMMIT=a300e35c0a4b4a38fb53742ea6e2a203c98ee523

# U-Boot release the board support was validated against.
UBOOT_URL=https://github.com/u-boot/u-boot.git
UBOOT_TAG=v2026.10-rc4
UBOOT_COMMIT=b4ac71db13a33c4e6532c60a781ddf34b7f4375a

# Ubuntu Base ARM64 userspace. The point release is served under 26.04/.
UBUNTU_BASE_VERSION=26.04.1
UBUNTU_BASE_ARCH=arm64
UBUNTU_BASE_URL=https://cdimage.ubuntu.com/ubuntu-base/releases/26.04/release
UBUNTU_BASE_ARCHIVE=ubuntu-base-26.04.1-base-arm64.tar.gz
UBUNTU_BASE_SHA256=5a1906794ced63a71a8119c3f211ef5f0bbe0a243001b4bbd41fdf80c5b219fd

# Rockchip binary firmware (DDR init TPL and BL31). Only these files are
# fetched, at the last rkbin commit that still shipped both versions.
RKBIN_URL=https://github.com/rockchip-linux/rkbin.git
RKBIN_RAW_URL=https://raw.githubusercontent.com/rockchip-linux/rkbin
RKBIN_COMMIT=50942f0b0500a6b4879f0048b5fd63482a8a151c
RKBIN_BL31=bin/rk35/rk3588_bl31_v1.46.elf
RKBIN_BL31_SHA256=f1c4632eb259273a408dc308808d418762ec5e76262e32605f97654c10d9f0c0
RKBIN_DDR=bin/rk35/rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v1.17.bin
RKBIN_DDR_SHA256=9e0095a52febfc0f57297dff71ecc82d1686b94d47be00c21391446fc6927f7a
RKBIN_DDRBIN_TOOL=tools/ddrbin_tool
RKBIN_DDRBIN_TOOL_SHA256=e72445c3a7fbfdd685ca26c981dbe0ced8ccae0dfde477120152f56d9efb286c
# The board's DDR blob is the upstream v1.17 file with the LPDDR4/LPDDR4X
# frequency limited to 1560 MHz (u-boot/ddrbin_param.txt); this is the
# checksum of the blob that booted the board.
BOARD_DDR_SHA256=c0a46864b4fe5872a948f2ec87988d7e961afdec472338cf6444a56928412827
