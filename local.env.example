# Copy to local.env and adjust. Sourced by scripts/lib.sh after manifest.env;
# every variable is optional and can also be given in the environment.

# Kernel: LLVM=1 uses clang/ld.lld from PATH, LLVM=-21 the versioned tools.
# The verified combination is clang/LLVM 21, rustc 1.98 and bindgen 0.72.
#LLVM=-21
# bindgen needs libclang; point at the matching library when it is not found.
#LIBCLANG_PATH=/usr/lib/llvm-21/lib
# Prepend directories holding bindgen, ld.lld-21 or other tools.
#PATH=/opt/rust-build/bin:$PATH
# Optional bindgen executable override (a path, without arguments).
#BSP_BINDGEN_BIN=/opt/rust-build/bin/bindgen
# Kbuild isolates bindgen from the host's RUST_LOG. Explicitly opt into its
# internal parser logs when debugging binding generation.
#BINDGEN_RUST_LOG=warn

# AArch64 GCC: links the application, provides the QEMU C runtime and builds
# U-Boot (CROSS_COMPILE defaults to its prefix).
#AARCH64_CC=aarch64-linux-gnu-gcc
#CROSS_COMPILE=aarch64-linux-gnu-

# QEMU for make qemu.
#QEMU=qemu-system-aarch64

# Parallel jobs (default: nproc).
#JOBS=16

# Firmware overrides; by default they come from the pinned rkbin release.
#BL31=/path/to/rk3588_bl31_v1.46.elf
#ROCKCHIP_TPL=/path/to/rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v1.17.bin

# Board access for make deploy / make flash-uboot FLASH_ARGS=--board.
#BOARD_HOST=ubuntu@10.42.0.88
#BOARD_SSH_OPTS="-i /path/to/key -o UserKnownHostsFile=/path/to/known_hosts"
#BOARD_SUDO=sudo
# Slint: a target sysroot from make display-sysroot and its output directory.
#DISPLAY_SYSROOT=$BSP_ROOT/build/slint-sysroot
#DISPLAY_OUT=$BSP_ROOT/build/slint
# Select the ADC-identified 5.5-inch 1080p panel on the first MIPI connector.
#BOARD_DTB=rk3588-atk-dlrk3588-mipi-1080p.dtb
# Or read ADC7 during packaging (board must be online, screen on J23).
# This form also permits a command-line override despite sourcing local.env:
#BOARD_DTB=${BOARD_DTB:-auto}
# Optional sudo password for BSP/display deploy and display tests; mode 0600, untracked.
#BOARD_SUDO_PASSWORD_FILE=/path/to/board-sudo-password
# Ubuntu upstream download/extraction and retained local snapshots.
#UBUNTU_BASE_DIR=/path/to/external/ubuntu-base
#UBUNTU_BASE_LOCAL=/path/to/local/ubuntu-base
# Migrated board credentials can be used directly from the BSP checkout:
#BOARD_SSH_OPTS="-i $BSP_ROOT/local/ubuntu-base/board-ssh -o UserKnownHostsFile=$BSP_ROOT/local/ubuntu-base/known_hosts -o HostKeyAlias=atk-rk3588-dev"

# Maskrom flashing (make flash-uboot FLASH_ARGS=--maskrom).
#RK_FLASH_TOOL=rkdeveloptool
#RK_LOADER=/path/to/MiniLoaderAll.bin

# Existing source checkouts instead of external/ (must be git clones
# containing the pinned tags; scripts/prepare.sh creates a branch there).
#LINUX_SRC=/path/to/linux
#UBOOT_SRC=/path/to/u-boot
