# Copy to local.env and adjust. Sourced by scripts/lib.sh after manifest.env;
# every variable is optional and can also be given in the environment.

# Kernel: LLVM=1 uses clang/ld.lld from PATH, LLVM=-21 the versioned tools.
# The verified combination is clang/LLVM 21, rustc 1.98 and bindgen 0.72.
#LLVM=-21
# bindgen needs libclang; point at the matching library when it is not found.
#LIBCLANG_PATH=/usr/lib/llvm-21/lib
# Prepend directories holding bindgen, ld.lld-21 or other tools.
#PATH=/opt/rust-build/bin:$PATH

# AArch64 GCC: links the application, provides the QEMU C runtime and builds
# U-Boot (CROSS_COMPILE defaults to its prefix).
#AARCH64_CC=aarch64-linux-gnu-gcc
#CROSS_COMPILE=aarch64-linux-gnu-

# QEMU for make qemu.
#QEMU=qemu-system-aarch64

# Parallel jobs (default: nproc).
#JOBS=16

# Firmware overrides; by default they come from the pinned rkbin release.
#BL31=/path/to/rk3588_bl31_v1.46.elf
#ROCKCHIP_TPL=/path/to/rk3588_ddr_lp4_2112MHz_lp5_2400MHz_v1.17.bin

# Board access for make deploy / make flash-uboot FLASH_ARGS=--board.
#BOARD_HOST=ubuntu@10.42.0.88
#BOARD_SSH_OPTS="-i /path/to/key -o UserKnownHostsFile=/path/to/known_hosts"
#BOARD_SUDO=sudo

# Maskrom flashing (make flash-uboot FLASH_ARGS=--maskrom).
#RK_FLASH_TOOL=rkdeveloptool
#RK_LOADER=/path/to/MiniLoaderAll.bin

# Existing source checkouts instead of external/ (must be git clones
# containing the pinned tags; scripts/prepare.sh creates a branch there).
#LINUX_SRC=/path/to/linux
#UBOOT_SRC=/path/to/u-boot
