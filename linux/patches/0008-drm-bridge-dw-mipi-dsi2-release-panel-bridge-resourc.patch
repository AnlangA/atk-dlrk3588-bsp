From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Realer Mason <stone-mason@dr.com>
Date: Tue, 15 Sep 2026 09:50:51 +0800
Subject: [PATCH 08/10] drm/bridge: dw-mipi-dsi2: release panel bridge
 resources on detach

The panel bridge is obtained through devm_drm_of_get_bridge(), but the
host detach callback removes it through drm_of_panel_bridge_remove().
This leaves its managed removal action behind. Removing the DSI host
later can remove the same bridge again and dereference a freed object.

Put the resources acquired for the downstream bridge in a devres group.
Release that group on detach and on attach failure, pairing managed
creation with managed cleanup and removing stale actions before a
peripheral can be attached again.

Reproduced the crash after panel reloads followed by rockchipdrm removal.
With this change, repeated panel reloads followed by removing and
reloading rockchipdrm complete without a WARN or Oops on RK3588.

Signed-off-by: Realer Mason <stone-mason@dr.com>
---
 .../gpu/drm/bridge/synopsys/dw-mipi-dsi2.c    | 20 ++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c b/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c
index 91d216ccdceb62f0de6ba4b0265d062862e1d6ea..f84b5382cb06c3708cc1c70980a66dce24719f4f 100644
--- a/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c
+++ b/drivers/gpu/drm/bridge/synopsys/dw-mipi-dsi2.c
@@ -193,6 +193,7 @@ struct dw_mipi_dsi2 {
 	struct drm_bridge bridge;
 	struct mipi_dsi_host dsi_host;
 	struct drm_bridge *panel_bridge;
+	void *panel_bridge_group;
 	struct device *dev;
 	struct regmap *regmap;
 	struct clk *pclk;
@@ -528,9 +529,16 @@ static int dw_mipi_dsi2_host_attach(struct mipi_dsi_host *host,
 	dsi2->format = device->format;
 	dsi2->mode_flags = device->mode_flags;
 
+	dsi2->panel_bridge_group = devres_open_group(dsi2->dev, NULL, GFP_KERNEL);
+	if (!dsi2->panel_bridge_group)
+		return -ENOMEM;
+
 	bridge = devm_drm_of_get_bridge(dsi2->dev, dsi2->dev->of_node, 1, 0);
-	if (IS_ERR(bridge))
-		return PTR_ERR(bridge);
+	devres_close_group(dsi2->dev, dsi2->panel_bridge_group);
+	if (IS_ERR(bridge)) {
+		ret = PTR_ERR(bridge);
+		goto err_release_bridge;
+	}
 
 	bridge->pre_enable_prev_first = true;
 	dsi2->panel_bridge = bridge;
@@ -547,6 +555,10 @@ static int dw_mipi_dsi2_host_attach(struct mipi_dsi_host *host,
 
 err_remove_bridge:
 	drm_bridge_remove(&dsi2->bridge);
+err_release_bridge:
+	devres_release_group(dsi2->dev, dsi2->panel_bridge_group);
+	dsi2->panel_bridge_group = NULL;
+	dsi2->panel_bridge = NULL;
 	return ret;
 }
 
@@ -565,7 +577,9 @@ static int dw_mipi_dsi2_host_detach(struct mipi_dsi_host *host,
 
 	drm_bridge_remove(&dsi2->bridge);
 
-	drm_of_panel_bridge_remove(host->dev->of_node, 1, 0);
+	devres_release_group(dsi2->dev, dsi2->panel_bridge_group);
+	dsi2->panel_bridge_group = NULL;
+	dsi2->panel_bridge = NULL;
 
 	return 0;
 }
