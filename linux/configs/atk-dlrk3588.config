# Board fragment merged on top of arch/arm64/configs/defconfig.
# Boot-critical drivers are built in so the board boots without an initramfs.
CONFIG_LOCALVERSION="-atk-dlrk3588"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_PINCTRL_RK805=y
CONFIG_MFD_RK8XX_SPI=y
CONFIG_REGULATOR_RK808=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_EXT4_FS=y
CONFIG_INITRAMFS_SOURCE=""
CONFIG_PANIC_TIMEOUT=0
# The on-board Ethernet PHYs are Motorcomm YT8531.
CONFIG_MOTORCOMM_PHY=m
