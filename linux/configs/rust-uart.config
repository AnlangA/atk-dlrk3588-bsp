# Fragment for the out-of-tree Rust UART controller and character device.
# rust/kernel/serial.rs is compiled only when SERIAL_CORE and DMA_ENGINE are
# built in; PL330 provides the RK3588 UART DMA channels; DEBUG_FS exposes the
# DMA counters. The modules themselves are built with Kbuild M= (see
# linux/drivers/Kbuild), so they need no Kconfig symbol of their own.
CONFIG_RUST=y
CONFIG_RUST_OVERFLOW_CHECKS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_SERIAL_CORE=y
CONFIG_DMA_ENGINE=y
CONFIG_PL330_DMA=y
CONFIG_DEBUG_FS=y
# The verified toolchain pairs rustc 1.98 (LLVM 22) with clang 21, so
# cross-language LTO and inline helpers are unavailable.
# CONFIG_RUST_INLINE_HELPERS is not set
# CONFIG_LTO_CLANG is not set
