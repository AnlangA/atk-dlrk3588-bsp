# Mainline KMS and input for Slint. These match the existing arm64 defconfig;
# list them explicitly so a future defconfig change cannot drop the display.
CONFIG_DRM=m
CONFIG_DRM_ROCKCHIP=m
CONFIG_DRM_PANTHOR=m
CONFIG_ROCKCHIP_VOP2=y
CONFIG_ROCKCHIP_DW_HDMI_QP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI2=y
CONFIG_PHY_ROCKCHIP_SAMSUNG_HDPTX=m
CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY=m
CONFIG_DRM_PANEL=y
CONFIG_BACKLIGHT_PWM=m
CONFIG_PWM_ROCKCHIP=y
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_ROCKCHIP_SARADC=m
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_INPUT_EVDEV=y
CONFIG_VT=y
