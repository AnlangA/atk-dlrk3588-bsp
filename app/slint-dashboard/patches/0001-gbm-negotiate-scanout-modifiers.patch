+    #[cfg(feature = "gbm")]
+    pub fn primary_modifiers(&self, format: drm::buffer::DrmFourcc) -> Result<Vec<u64>, PlatformError> {
+        self.drm_device.set_client_capability(drm::ClientCapability::UniversalPlanes, true)
+            .map_err(|e| format!("Cannot enumerate DRM planes: {e}"))?;
+        let resources = self.drm_device.resource_handles().map_err(|e| e.to_string())?;
+        for handle in self.drm_device.plane_handles().map_err(|e| e.to_string())? {
+            let plane = self.drm_device.get_plane(handle).map_err(|e| e.to_string())?;
+            if !resources.filter_crtcs(plane.possible_crtcs()).contains(&self.crtc) {
+                continue;
+            }
+            let properties = self.drm_device.get_properties(handle).map_err(|e| e.to_string())?;
+            let mut primary = false;
+            let mut blob_id = None;
+            for (&property, &value) in properties.iter() {
+                let info = self.drm_device.get_property(property).map_err(|e| e.to_string())?;
+                match info.name().to_bytes() {
+                    b"type" => primary = value == drm::control::PlaneType::Primary as u64,
+                    b"IN_FORMATS" if value != 0 => blob_id = Some(value),
+                    _ => {}
+                }
+            }
+            if !primary || !plane.formats().contains(&(format as u32)) {
+                continue;
+            }
+            let modifiers = if let Some(id) = blob_id {
+                let blob = self.drm_device.get_property_blob(id).map_err(|e| e.to_string())?;
+                crate::drmformats::modifiers_for_format(&blob, format as u32)
+                    .ok_or_else(|| "Malformed DRM IN_FORMATS blob".to_string())?
+            } else {
+                vec![0] // Legacy KMS advertises implicit linear formats.
+            };
+            if modifiers.is_empty() {
+                return Err("Primary plane does not advertise a modifier for XRGB8888".into());
+            }
+            eprintln!("DRM_OUTPUT: {}-{}; CRTC={:?}; primary={:?}; format={format:?}; modifiers={modifiers:x?}",
+                self.connector.interface().as_str(), self.connector.interface_id(), self.crtc, handle);
+            return Ok(modifiers);
+        }
+        Err("No compatible DRM primary plane for GPU scanout".into())
     }
 
